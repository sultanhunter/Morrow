// morrow-<env>-connector (M2 PR-2; ADR-0022 item 6; ADR-0008 as amended 2026-10-20): the
// Shopify launch, callback, status and webhook routes on the connector's own hostname, so
// the api's __Host- session cookie never reaches it. It binds MORROW_ENVIRONMENT and the
// broker's ConnectorBroker entrypoint only; no secret, no Shopify library and no provider
// credential (every secret-dependent Shopify call is in the broker). The reviewed staging
// identifiers (CONNECTOR_CONFIGURATION_JSON, MORROW_DATABASE_BINDING_JSON) arrive through
// the P04.T01i PR-D path; without them the connector is deny-all (503). v1 PR 1 (ADR-0035
// item 2, amending ADR-0019 item 2 and ADR-0022 item 6): the staging connector is on its
// workers.dev hostname, so Shopify can reach it, with both reviewed identifiers (its own
// origin and the api's; the database binding byte-equal to the api's). The census admits
// workers.dev on the api and the connector only, and the kill switch takes both down.
// M2 PR-2 review (ADR-0019 items 6 and 8 applied to the second public Worker): the
// per-address ingress limits, launch, status and callback 20 and webhooks 300 per 60 s
// (Shopify's delivery addresses are shared by every store's app), one namespace per limit
// and environment (development 7004-7005, staging 7104-7105, production 7204-7205).
// `ratelimits` is not inherited, so every environment names its own. M2 PR-3 (review
// finding B8): one cron trigger, every five minutes, runs the ids-only re-drives of the
// webhook inbox and of ended installations' tokens (worker/index.ts scheduled); named in
// every environment, exactly as scripts/edge.mjs edgeConnectorCrons pins it.
// fix-connector-cron-latency (docs/briefs/fix-connector-cron-latency.md): placement moves
// only fetch handlers, so the cron ran wherever Cloudflare put it, with its database
// transactions and its broker RPCs beside it. scheduled() now hands the run to one Durable
// Object, ConnectorCron (CONNECTOR_CRON, created with the location hint of the Neon region,
// worker/cron.ts), so the run and every call it makes start beside the database. The class
// is SQLite-backed and stores nothing. Only this Worker binds it; it adds no route,
// hostname, secret or grant. `durable_objects` is not inherited, so every environment
// names it, exactly as scripts/edge.mjs edgeConnectorDurableObjects pins it, with the one
// migration edgeConnectorMigrations pins.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "morrow-development-connector",
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "upload_source_maps": false,
  "keep_vars": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": { "MORROW_ENVIRONMENT": "development" },
  "services": [
    {
      "binding": "BROKER",
      "service": "morrow-development-broker",
      "entrypoint": "ConnectorBroker",
    },
  ],
  "ratelimits": [
    { "name": "INSTALL_LIMITER", "namespace_id": "7004", "simple": { "limit": 20, "period": 60 } },
    { "name": "WEBHOOK_LIMITER", "namespace_id": "7005", "simple": { "limit": 300, "period": 60 } },
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "durable_objects": { "bindings": [{ "name": "CONNECTOR_CRON", "class_name": "ConnectorCron" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConnectorCron"] }],
  "secrets": { "required": [] },
  "env": {
    // P04.T01i D1 and D6: no preview URL or route; Workers Logs as the api's. v1 PR 1: the
    // workers.dev hostname is on (ADR-0035 item 2).
    "staging": {
      "name": "morrow-staging-connector",
      "workers_dev": true,
      "preview_urls": false,
      // fix-shopify-install-live (2026-10-25): the api's and the broker's placement, in the
      // committed Neon endpoint's region (staging.json neon.region_id aws-us-east-1). The
      // launch and the callback ran at the edge nearest the merchant, and so did the
      // broker's ConnectorBroker RPC they make, so each vault transaction's sequential round
      // trips crossed to us-east-1 and the first live launches ran out of their 3 s budget.
      // A performance setting: no binding, route, secret or trust boundary changes; the
      // client address (CF-Connecting-IP) the ingress limits count is kept.
      "placement": { "mode": "targeted", "region": "aws:us-east-1" },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": { "enabled": false },
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
          "persist": true,
        },
      },
      "vars": {
        "MORROW_ENVIRONMENT": "staging",
        "CONNECTOR_CONFIGURATION_JSON": "{\"schemaVersion\":1,\"origin\":\"https://morrow-staging-connector.sultanibneusman0.workers.dev\",\"apiOrigin\":\"https://morrow-staging-api.sultanibneusman0.workers.dev\"}",
        "MORROW_DATABASE_BINDING_JSON": "{\"schemaVersion\":1,\"environment\":\"staging\",\"projectId\":\"sweet-sound-23947873\",\"branchId\":\"br-dark-recipe-b78ytwj9\",\"hostname\":\"ep-hidden-mouse-b7e6ff6l.c-13.us-east-1.aws.neon.tech\",\"database\":\"morrow\"}",
      },
      "services": [
        {
          "binding": "BROKER",
          "service": "morrow-staging-broker",
          "entrypoint": "ConnectorBroker",
        },
      ],
      "ratelimits": [
        {
          "name": "INSTALL_LIMITER",
          "namespace_id": "7104",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "WEBHOOK_LIMITER",
          "namespace_id": "7105",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "CONNECTOR_CRON", "class_name": "ConnectorCron" }],
      },
      "secrets": { "required": [] },
    },
    "production": {
      "name": "morrow-production-connector",
      "vars": { "MORROW_ENVIRONMENT": "production" },
      "services": [
        {
          "binding": "BROKER",
          "service": "morrow-production-broker",
          "entrypoint": "ConnectorBroker",
        },
      ],
      "ratelimits": [
        {
          "name": "INSTALL_LIMITER",
          "namespace_id": "7204",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "WEBHOOK_LIMITER",
          "namespace_id": "7205",
          "simple": { "limit": 300, "period": 60 },
        },
      ],
      "triggers": { "crons": ["*/5 * * * *"] },
      "durable_objects": {
        "bindings": [{ "name": "CONNECTOR_CRON", "class_name": "ConnectorCron" }],
      },
      "secrets": { "required": [] },
    },
  },
}
