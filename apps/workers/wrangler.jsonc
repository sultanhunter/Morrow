// morrow-<env>-orchestrator (P04.T02a D8; M3 PR-2, mvp-architecture §3): ListingsRunWorkflow
// (one instance per run, ids only), the dispatch Queue consumer with its dead-letter queue
// (no producer: the cron starts runs), a one-minute cron over pending_starts(), and the
// broker's RuntimeBroker entrypoint (its role lease and modelRespond). No secret, route or
// provider credential. Development and production carry MORROW_ENVIRONMENT only, so dispatch
// stays disabled there (every Workflow throws dispatch_disabled before any step). The reviewed
// model-provider switch (docs/decisions/model-provider-staging.json) is on in staging since
// the model-provider-on commit (2026-10-25), which added MORROW_MODEL_PROVIDER and the
// reviewed MORROW_DATABASE_BINDING_JSON to env.staging.vars (edge:check refuses any mixed
// state). Build order PR 11 adds AgentRunWorkflow (one instance per agent run, ids only),
// dispatched only while the reviewed agent-loop switch (docs/decisions/agent-loop-staging.json,
// committed off) is on as well; its reviewed commit adds MORROW_AGENT_LOOP to env.staging.vars.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "morrow-development-orchestrator",
  "main": "src/orchestrator.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "upload_source_maps": false,
  "keep_vars": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": { "MORROW_ENVIRONMENT": "development" },
  "services": [
    { "binding": "BROKER", "service": "morrow-development-broker", "entrypoint": "RuntimeBroker" },
  ],
  "workflows": [
    {
      "name": "morrow-development-listings-run",
      "binding": "LISTINGS_RUN",
      "class_name": "ListingsRunWorkflow",
    },
    {
      "name": "morrow-development-agent-run",
      "binding": "AGENT_RUN",
      "class_name": "AgentRunWorkflow",
    },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "morrow-development-dispatch",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "morrow-development-dispatch-dlq",
      },
    ],
  },
  "triggers": { "crons": ["* * * * *"] },
  "secrets": { "required": [] },
  "env": {
    // P04.T01i D1 and D6: no workers.dev, preview URL or route; Workers Logs as the api's.
    "staging": {
      "name": "morrow-staging-orchestrator",
      "workers_dev": false,
      "preview_urls": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": { "enabled": false },
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
          "persist": true,
        },
      },
      // The model-provider switch, on (docs/decisions/model-provider-staging.json): dispatch
      // with the reviewed database binding, byte-equal to the api's and the broker's.
      "vars": {
        "MORROW_ENVIRONMENT": "staging",
        "MORROW_MODEL_PROVIDER": "anthropic",
        "MORROW_DATABASE_BINDING_JSON": "{\"schemaVersion\":1,\"environment\":\"staging\",\"projectId\":\"sweet-sound-23947873\",\"branchId\":\"br-dark-recipe-b78ytwj9\",\"hostname\":\"ep-hidden-mouse-b7e6ff6l.c-13.us-east-1.aws.neon.tech\",\"database\":\"morrow\"}",
      },
      "services": [
        { "binding": "BROKER", "service": "morrow-staging-broker", "entrypoint": "RuntimeBroker" },
      ],
      "workflows": [
        {
          "name": "morrow-staging-listings-run",
          "binding": "LISTINGS_RUN",
          "class_name": "ListingsRunWorkflow",
        },
        {
          "name": "morrow-staging-agent-run",
          "binding": "AGENT_RUN",
          "class_name": "AgentRunWorkflow",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "morrow-staging-dispatch",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "morrow-staging-dispatch-dlq",
          },
        ],
      },
      "triggers": { "crons": ["* * * * *"] },
      "secrets": { "required": [] },
    },
    "production": {
      "name": "morrow-production-orchestrator",
      "vars": { "MORROW_ENVIRONMENT": "production" },
      "services": [
        {
          "binding": "BROKER",
          "service": "morrow-production-broker",
          "entrypoint": "RuntimeBroker",
        },
      ],
      "workflows": [
        {
          "name": "morrow-production-listings-run",
          "binding": "LISTINGS_RUN",
          "class_name": "ListingsRunWorkflow",
        },
        {
          "name": "morrow-production-agent-run",
          "binding": "AGENT_RUN",
          "class_name": "AgentRunWorkflow",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "morrow-production-dispatch",
            "max_batch_size": 1,
            "max_retries": 3,
            "dead_letter_queue": "morrow-production-dispatch-dlq",
          },
        ],
      },
      "triggers": { "crons": ["* * * * *"] },
      "secrets": { "required": [] },
    },
  },
}
