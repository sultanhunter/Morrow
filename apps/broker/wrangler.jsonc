// morrow-<env>-broker (ADR-0007): no public route, no workers.dev or preview
// URL; reachable only through the ApiBroker service-binding entrypoint. It is
// the only Worker that binds provider credentials: the WorkOS API key and the
// seven Neon runtime-role passwords (`brokerRequiredSecrets`). No identifier is
// committed; the first hosted deploy fails closed until P04.T01i supplies
// `wrangler deploy --secrets-file`. Never add merchant or model credentials
// under the v0 trust model.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "morrow-development-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "upload_source_maps": false,
  "keep_vars": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "vars": { "MORROW_ENVIRONMENT": "development" },
  "secrets": {
    "required": [
      "WORKOS_API_KEY",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_RESOLUTION",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
      "MORROW_DB_PASSWORD_MORROW_API",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
    ],
  },
  "env": {
    "staging": {
      "name": "morrow-staging-broker",
      "vars": { "MORROW_ENVIRONMENT": "staging" },
      "secrets": {
        "required": [
          "WORKOS_API_KEY",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_RESOLUTION",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
          "MORROW_DB_PASSWORD_MORROW_API",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
        ],
      },
    },
    "production": {
      "name": "morrow-production-broker",
      "vars": { "MORROW_ENVIRONMENT": "production" },
      "secrets": {
        "required": [
          "WORKOS_API_KEY",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_RESOLUTION",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
          "MORROW_DB_PASSWORD_MORROW_API",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
        ],
      },
    },
  },
}
