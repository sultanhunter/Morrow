// morrow-<env>-broker (ADR-0007): no public route, no workers.dev or preview
// URL; reachable only through its service-binding entrypoints (ApiBroker, and under
// trust model v1 ConnectorBroker and RuntimeBroker, ADR-0022 item 7). It is the only
// Worker that binds provider credentials (`brokerRequiredSecretsFor`, 14 names): the
// WorkOS API key, the Turnstile secret (P05.T01ab, ADR-0019 item 6), the ten leased Neon
// role passwords, its own vault login's password and the vault KEK (MORROW_VAULT_KEK_V1);
// production omits the last two (12 names; the vault is held there until the ADR-0007
// item 9 production custody ADR). M5 PR-1's Stripe restricted test key and webhook signing
// secret (ADR-0022 items 7 and 12) join env.staging only while the reviewed Stripe switch
// is on (docs/decisions/stripe-staging.json `switch`; off by owner decision (c),
// 2026-10-21), with MORROW_STRIPE_MODE and STRIPE_CONFIGURATION_JSON in env.staging.vars;
// edge:check refuses any mixed state. Only env.staging.vars hold identifiers (P04.T01i
// PR-D part 1); the first hosted deploy fails closed until P04.T01i supplies
// `wrangler deploy --secrets-file`. Merchant and
// model credentials come only under trust model v1, as vault rows or the secrets
// ADR-0022 item 7 admits, each with the PR that uses it.
// M2 PR-2: the bundle includes the Neon driver (the vault login's own transport,
// src/vault-database.ts; about 150 KB, already minified) and is minified as a whole, so
// it stays under the 384 KiB cap of scripts/edge.mjs (`edgeBundleLimits.brokerBytes`)
// with room for M4 and M5's Stripe code. The cap was 256 KiB until 2026-10-22, when M2
// PR-3 plus M3 PR-2 measured 264,479 bytes (confirmed by the owner on 2026-10-22,
// "yes to all recommended"). The broker never logs a stack or a name, so minifying
// changes no reviewed output; export (entrypoint) names are kept.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "morrow-development-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "upload_source_maps": false,
  "keep_vars": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "minify": true,
  "vars": { "MORROW_ENVIRONMENT": "development" },
  "secrets": {
    "required": [
      "WORKOS_API_KEY",
      "TURNSTILE_SECRET_KEY",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
      "MORROW_DB_PASSWORD_MORROW_API",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_ONBOARDING",
      "MORROW_DB_PASSWORD_MORROW_API_WORKER",
      "MORROW_DB_PASSWORD_MORROW_CONNECTOR_INGRESS",
      "MORROW_DB_PASSWORD_MORROW_RUNTIME_EXECUTOR",
      "MORROW_DB_PASSWORD_MORROW_VAULT_BROKER",
      "MORROW_VAULT_KEK_V1",
    ],
  },
  "env": {
    // P04.T01i D1 (PR-D part 1): no workers.dev or preview URL; Workers Logs as the api's.
    // LOGIN_CONFIGURATION_JSON and MORROW_DATABASE_BINDING_JSON are byte-equal to the api's;
    // TURNSTILE_CONFIGURATION_JSON names the origin's hostname and the api's actions.
    "staging": {
      "name": "morrow-staging-broker",
      "workers_dev": false,
      "preview_urls": false,
      // P04.T01i D1 (2026-10-21): the api's placement, in the committed Neon endpoint's
      // region (staging.json neon.region_id aws-us-east-1), so the role leases the api asks
      // for on its database path are answered in the same region. A performance setting:
      // no binding, route, secret or trust boundary changes.
      "placement": { "mode": "targeted", "region": "aws:us-east-1" },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": { "enabled": false },
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
          "persist": true,
        },
      },
      "vars": {
        "MORROW_ENVIRONMENT": "staging",
        "LOGIN_CONFIGURATION_JSON": "{\"schemaVersion\":1,\"controllerProtocol\":\"morrow-login-v1\",\"origin\":\"https://morrow-staging-api.sultanibneusman0.workers.dev\",\"retentionTier\":\"staging\",\"authenticationBindingJson\":\"{\\\"bindingId\\\":\\\"workos_staging_login\\\",\\\"bindingRevision\\\":1,\\\"environmentId\\\":\\\"environment_01M4HG7FV7X8EFXE1J9S6GG00R\\\",\\\"applicationId\\\":\\\"app_01M4HG7GEJJWTKG4W16RB98VZE\\\",\\\"clientId\\\":\\\"client_01M4HG7GA0DX8C3PFSQHBP4BN3\\\",\\\"redirectUri\\\":\\\"https://morrow-staging-api.sultanibneusman0.workers.dev/auth/workos/callback\\\",\\\"returnPath\\\":\\\"/\\\"}\",\"verificationProfileJson\":\"{\\\"schemaVersion\\\":1,\\\"providerId\\\":\\\"workos\\\",\\\"environmentId\\\":\\\"environment_01M4HG7FV7X8EFXE1J9S6GG00R\\\",\\\"applicationId\\\":\\\"app_01M4HG7GEJJWTKG4W16RB98VZE\\\",\\\"clientId\\\":\\\"client_01M4HG7GA0DX8C3PFSQHBP4BN3\\\",\\\"issuer\\\":\\\"https://api.workos.com/user_management/client_01M4HG7GA0DX8C3PFSQHBP4BN3\\\",\\\"revision\\\":1,\\\"audiencePolicy\\\":\\\"absent\\\"}\",\"profileId\":\"workos_staging_profile\",\"profileRecordRevision\":1}",
        "MORROW_DATABASE_BINDING_JSON": "{\"schemaVersion\":1,\"environment\":\"staging\",\"projectId\":\"sweet-sound-23947873\",\"branchId\":\"br-dark-recipe-b78ytwj9\",\"hostname\":\"ep-hidden-mouse-b7e6ff6l.c-13.us-east-1.aws.neon.tech\",\"database\":\"morrow\"}",
        "TURNSTILE_CONFIGURATION_JSON": "{\"schemaVersion\":1,\"hostname\":\"morrow-staging-api.sultanibneusman0.workers.dev\",\"actions\":{\"login\":\"account_login\",\"signup\":\"organization_signup\"}}",
        // The shop-specific webhook subscriptions (docs/briefs/shopify-shop-specific-webhooks.md):
        // byte-equal to the connector's; the broker builds each callback URL from its origin.
        "CONNECTOR_CONFIGURATION_JSON": "{\"schemaVersion\":1,\"origin\":\"https://morrow-staging-connector.sultanibneusman0.workers.dev\",\"apiOrigin\":\"https://morrow-staging-api.sultanibneusman0.workers.dev\"}",
      },
      "secrets": {
        "required": [
          "WORKOS_API_KEY",
          "TURNSTILE_SECRET_KEY",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
          "MORROW_DB_PASSWORD_MORROW_API",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_ONBOARDING",
          "MORROW_DB_PASSWORD_MORROW_API_WORKER",
          "MORROW_DB_PASSWORD_MORROW_CONNECTOR_INGRESS",
          "MORROW_DB_PASSWORD_MORROW_RUNTIME_EXECUTOR",
          "MORROW_DB_PASSWORD_MORROW_VAULT_BROKER",
          "MORROW_VAULT_KEK_V1",
        ],
      },
    },
    // Production holds the vault and Stripe until the production custody ADR (ADR-0007
    // item 9), so it requires neither the vault login's password, a KEK nor a Stripe secret
    // and has no Stripe switch (brokerRequiredSecretsFor). No placement in development or
    // production, which waits for its own database and region (verify-config requires the
    // key absent outside staging).
    "production": {
      "name": "morrow-production-broker",
      "vars": { "MORROW_ENVIRONMENT": "production" },
      "secrets": {
        "required": [
          "WORKOS_API_KEY",
          "TURNSTILE_SECRET_KEY",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
          "MORROW_DB_PASSWORD_MORROW_API",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_ONBOARDING",
          "MORROW_DB_PASSWORD_MORROW_API_WORKER",
          "MORROW_DB_PASSWORD_MORROW_CONNECTOR_INGRESS",
          "MORROW_DB_PASSWORD_MORROW_RUNTIME_EXECUTOR",
        ],
      },
    },
  },
}
