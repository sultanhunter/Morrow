// morrow-<env>-broker (ADR-0007): no public route, no workers.dev or preview
// URL; reachable only through its service-binding entrypoints (ApiBroker, and under
// trust model v1 ConnectorBroker and RuntimeBroker, ADR-0022 item 7). It is the only
// Worker that binds provider credentials (`brokerRequiredSecrets`, 14 names): the WorkOS
// API key, the Turnstile secret (P05.T01ab, ADR-0019 item 6), the ten leased Neon role
// passwords, its own vault login's password and the vault KEK (MORROW_VAULT_KEK_V1);
// production omits the last two (12 names; the vault is held there until the ADR-0007
// item 9 production custody ADR). No identifier is committed; the first hosted deploy
// fails closed until P04.T01i supplies `wrangler deploy --secrets-file`. Merchant and
// model credentials come only under trust model v1, as vault rows or the secrets
// ADR-0022 item 7 admits, each with the PR that uses it.
// M2 PR-2: the bundle includes the Neon driver (the vault login's own transport,
// src/vault-database.ts; about 150 KB, already minified) and is minified as a whole, so
// it stays under the 256 KiB cap of scripts/edge.mjs with room for M5's Stripe code. The
// broker never logs a stack or a name, so minifying changes no reviewed output; export
// (entrypoint) names are kept.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "morrow-development-broker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "upload_source_maps": false,
  "keep_vars": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "minify": true,
  "vars": { "MORROW_ENVIRONMENT": "development" },
  "secrets": {
    "required": [
      "WORKOS_API_KEY",
      "TURNSTILE_SECRET_KEY",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
      "MORROW_DB_PASSWORD_MORROW_API",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
      "MORROW_DB_PASSWORD_MORROW_IDENTITY_ONBOARDING",
      "MORROW_DB_PASSWORD_MORROW_API_WORKER",
      "MORROW_DB_PASSWORD_MORROW_CONNECTOR_INGRESS",
      "MORROW_DB_PASSWORD_MORROW_RUNTIME_EXECUTOR",
      "MORROW_DB_PASSWORD_MORROW_VAULT_BROKER",
      "MORROW_VAULT_KEK_V1",
    ],
  },
  "env": {
    "staging": {
      "name": "morrow-staging-broker",
      "vars": { "MORROW_ENVIRONMENT": "staging" },
      "secrets": {
        "required": [
          "WORKOS_API_KEY",
          "TURNSTILE_SECRET_KEY",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
          "MORROW_DB_PASSWORD_MORROW_API",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_ONBOARDING",
          "MORROW_DB_PASSWORD_MORROW_API_WORKER",
          "MORROW_DB_PASSWORD_MORROW_CONNECTOR_INGRESS",
          "MORROW_DB_PASSWORD_MORROW_RUNTIME_EXECUTOR",
          "MORROW_DB_PASSWORD_MORROW_VAULT_BROKER",
          "MORROW_VAULT_KEK_V1",
        ],
      },
    },
    // Production holds the vault until the production custody ADR (ADR-0007 item 9), so
    // it requires neither the vault login's password nor a KEK (brokerRequiredSecretsFor).
    "production": {
      "name": "morrow-production-broker",
      "vars": { "MORROW_ENVIRONMENT": "production" },
      "secrets": {
        "required": [
          "WORKOS_API_KEY",
          "TURNSTILE_SECRET_KEY",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGIN",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_PREAUTH",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_SESSIONS",
          "MORROW_DB_PASSWORD_MORROW_API",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LINKING",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_LOGOUT",
          "MORROW_DB_PASSWORD_MORROW_IDENTITY_ONBOARDING",
          "MORROW_DB_PASSWORD_MORROW_API_WORKER",
          "MORROW_DB_PASSWORD_MORROW_CONNECTOR_INGRESS",
          "MORROW_DB_PASSWORD_MORROW_RUNTIME_EXECUTOR",
        ],
      },
    },
  },
}
