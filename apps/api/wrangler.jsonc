// morrow-<env>-api: the only public Worker (ADR-0007 item 1). Static Assets
// serve apps/workspace-web/dist on the same origin as the reserved Worker paths,
// which the __Host- cookies require. No account or route is committed, and
// identifiers only in env.staging.vars (P04.T01i D1; no domain or zone).
// Its only secret is its own login keyring, placed with --secrets-file; with
// `secrets.required: []` types and dev never infer or load api secrets.
// P05.T01ab (ADR-0019 item 8): the per-address sign-in limits, one namespace per
// route and environment (development 7001-7003, staging 7101-7103, production
// 7201-7203). `ratelimits` is not inherited, so every environment names its own.
// SESSION_LIMITER (ADR-0019 item 8 applied to the session routes, src/session-limit.ts):
// 120 per 60 s per address on /workspaces, /workspace/* and logout and rotate, in 7006,
// 7106 and 7206 (the connector holds 7004-7005, 7104-7105 and 7204-7205).
// P04.T01i PR-D part 1 commits the reviewed staging identifiers in env.staging.vars
// only: the login, workspace and logout configurations, the database binding and
// LOGIN_CHALLENGE_JSON (the Turnstile site key). Development and production bind none.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "morrow-development-api",
  "main": "src/deployed-worker.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_do_not_populate_process_env"],
  "workers_dev": false,
  "preview_urls": false,
  "logpush": false,
  "upload_source_maps": false,
  "keep_vars": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../workspace-web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/auth",
      "/auth/*",
      "/workspace",
      "/workspace/*",
      "/workspaces",
      "/organizations",
      "/api",
      "/api/*",
      "/healthz",
    ],
  },
  "vars": { "MORROW_ENVIRONMENT": "development" },
  "services": [
    { "binding": "BROKER", "service": "morrow-development-broker", "entrypoint": "ApiBroker" },
  ],
  "ratelimits": [
    {
      "name": "LOGIN_START_LIMITER",
      "namespace_id": "7001",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "LOGIN_CALLBACK_LIMITER",
      "namespace_id": "7002",
      "simple": { "limit": 20, "period": 60 },
    },
    { "name": "SIGNUP_LIMITER", "namespace_id": "7003", "simple": { "limit": 5, "period": 60 } },
    {
      "name": "SESSION_LIMITER",
      "namespace_id": "7006",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "secrets": { "required": [] },
  "dev": { "ip": "127.0.0.1", "port": 8787, "local_protocol": "https" },
  "env": {
    // P04.T01i D1 (PR-D part 1): the only Worker on workers.dev, at the staging origin
    // https://morrow-staging-api.sultanibneusman0.workers.dev; Workers Logs on, invocation
    // logs and traces off (D6). The vars are the reviewed public identifiers only (WorkOS
    // environment, application and client; the Neon `staging` branch and its direct
    // endpoint; the Turnstile site key; the origin) in the shapes the mapper parses
    // (apps/api/src/environment.ts). verify-config holds every rule (AC01, AC02).
    "staging": {
      "name": "morrow-staging-api",
      "workers_dev": true,
      "preview_urls": false,
      // P04.T01i D1 (2026-10-21): targeted placement in the region of the committed Neon
      // endpoint (staging.json neon.region_id aws-us-east-1; verify-config ties the two), so
      // the database path's sequential round trips stay inside us-east-1 instead of crossing
      // from the edge nearest the caller (the first deploy's SMOKE_DATABASE_PATH). The api
      // opens the database sessions; the broker, which answers its lease RPCs, has the same
      // placement. A performance setting: no binding, route, secret or trust boundary changes.
      "placement": { "mode": "targeted", "region": "aws:us-east-1" },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
        "traces": { "enabled": false },
        "logs": {
          "enabled": true,
          "invocation_logs": false,
          "head_sampling_rate": 1,
          "persist": true,
        },
      },
      "vars": {
        "MORROW_ENVIRONMENT": "staging",
        "LOGIN_CONFIGURATION_JSON": "{\"schemaVersion\":1,\"controllerProtocol\":\"morrow-login-v1\",\"origin\":\"https://morrow-staging-api.sultanibneusman0.workers.dev\",\"retentionTier\":\"staging\",\"authenticationBindingJson\":\"{\\\"bindingId\\\":\\\"workos_staging_login\\\",\\\"bindingRevision\\\":1,\\\"environmentId\\\":\\\"environment_01M4HG7FV7X8EFXE1J9S6GG00R\\\",\\\"applicationId\\\":\\\"app_01M4HG7GEJJWTKG4W16RB98VZE\\\",\\\"clientId\\\":\\\"client_01M4HG7GA0DX8C3PFSQHBP4BN3\\\",\\\"redirectUri\\\":\\\"https://morrow-staging-api.sultanibneusman0.workers.dev/auth/workos/callback\\\",\\\"returnPath\\\":\\\"/\\\"}\",\"verificationProfileJson\":\"{\\\"schemaVersion\\\":1,\\\"providerId\\\":\\\"workos\\\",\\\"environmentId\\\":\\\"environment_01M4HG7FV7X8EFXE1J9S6GG00R\\\",\\\"applicationId\\\":\\\"app_01M4HG7GEJJWTKG4W16RB98VZE\\\",\\\"clientId\\\":\\\"client_01M4HG7GA0DX8C3PFSQHBP4BN3\\\",\\\"issuer\\\":\\\"https://api.workos.com/user_management/client_01M4HG7GA0DX8C3PFSQHBP4BN3\\\",\\\"revision\\\":1,\\\"audiencePolicy\\\":\\\"absent\\\"}\",\"profileId\":\"workos_staging_profile\",\"profileRecordRevision\":1}",
        "WORKSPACE_CONFIGURATION_JSON": "{\"schemaVersion\":1,\"mode\":\"https\",\"origin\":\"https://morrow-staging-api.sultanibneusman0.workers.dev\"}",
        "LOGOUT_CONFIGURATION_JSON": "{\"schemaVersion\":1,\"protocol\":\"morrow-self-logout-v1\",\"origin\":\"https://morrow-staging-api.sultanibneusman0.workers.dev\",\"providerId\":\"workos\",\"environmentId\":\"environment_01M4HG7FV7X8EFXE1J9S6GG00R\",\"applicationId\":\"app_01M4HG7GEJJWTKG4W16RB98VZE\",\"clientId\":\"client_01M4HG7GA0DX8C3PFSQHBP4BN3\",\"profileId\":\"workos_staging_profile\"}",
        "MORROW_DATABASE_BINDING_JSON": "{\"schemaVersion\":1,\"environment\":\"staging\",\"projectId\":\"sweet-sound-23947873\",\"branchId\":\"br-dark-recipe-b78ytwj9\",\"hostname\":\"ep-hidden-mouse-b7e6ff6l.c-13.us-east-1.aws.neon.tech\",\"database\":\"morrow\"}",
        "LOGIN_CHALLENGE_JSON": "{\"schemaVersion\":1,\"provider\":\"turnstile\",\"siteKey\":\"0x4AAAAAAFdwF1eDox4vfBd2\",\"actions\":{\"login\":\"account_login\",\"signup\":\"organization_signup\"}}",
        // M3 PR-2's model-provider switch, on (docs/decisions/model-provider-staging.json):
        // run admission opens only with it (and the broker's product read).
        "MORROW_MODEL_PROVIDER": "anthropic",
      },
      "services": [
        { "binding": "BROKER", "service": "morrow-staging-broker", "entrypoint": "ApiBroker" },
      ],
      "ratelimits": [
        {
          "name": "LOGIN_START_LIMITER",
          "namespace_id": "7101",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "LOGIN_CALLBACK_LIMITER",
          "namespace_id": "7102",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "SIGNUP_LIMITER",
          "namespace_id": "7103",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "SESSION_LIMITER",
          "namespace_id": "7106",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "secrets": { "required": [] },
    },
    // No placement in development (no hosted database) or production, which waits for its
    // own database and region (verify-config requires the key absent outside staging).
    "production": {
      "name": "morrow-production-api",
      "vars": { "MORROW_ENVIRONMENT": "production" },
      "services": [
        { "binding": "BROKER", "service": "morrow-production-broker", "entrypoint": "ApiBroker" },
      ],
      "ratelimits": [
        {
          "name": "LOGIN_START_LIMITER",
          "namespace_id": "7201",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "LOGIN_CALLBACK_LIMITER",
          "namespace_id": "7202",
          "simple": { "limit": 20, "period": 60 },
        },
        {
          "name": "SIGNUP_LIMITER",
          "namespace_id": "7203",
          "simple": { "limit": 5, "period": 60 },
        },
        {
          "name": "SESSION_LIMITER",
          "namespace_id": "7206",
          "simple": { "limit": 120, "period": 60 },
        },
      ],
      "secrets": { "required": [] },
    },
  },
}
