{
  "name": "@morrow/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build:worker": "esbuild src/worker.ts --bundle --platform=browser --format=esm --target=es2022 --external:node:* --outfile=dist/worker.mjs --metafile=dist/worker.meta.json"
  },
  "dependencies": {
    "@morrow/contracts": "0.0.0"
  }
}
