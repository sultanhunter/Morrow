    "content_sent": [
      "the person's request text",
      "the agent's role prompt and its pinned skill bodies",
      "the run's offered tool definitions",
      "tool results and other untrusted content, wrapped as data naming their source",
      "the run's own earlier turns, reasoning blocks included"
