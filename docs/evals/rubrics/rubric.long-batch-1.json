{
  "schemaVersion": 1,
  "rubricId": "rubric.long-batch@1",
  "title": "Long batches that finish without a check-in",
  "criteria": [
    {
      "criterionId": "answer_given",
      "kind": "code",
      "weight": 1,
      "text": "The job ends with an answer for the person.",
      "hook": {
        "id": "final_reply_present",
        "terms": []
      }
    },
    {
      "criterionId": "teammates_propose",
      "kind": "code",
      "weight": 1,
      "text": "Only teammates propose store changes.",
      "hook": {
        "id": "proposals_by_teammates_only",
        "terms": []
      }
    },
    {
      "criterionId": "covers_all",
      "kind": "model",
      "weight": 3,
      "text": "The answer accounts for every record in the batch: done, skipped with a reason, or failed.",
      "hook": null
    },
    {
      "criterionId": "no_early_stop",
      "kind": "model",
      "weight": 2,
      "text": "The agent never stops early or summarises a partial batch as the whole.",
      "hook": null
    }
  ]
}
