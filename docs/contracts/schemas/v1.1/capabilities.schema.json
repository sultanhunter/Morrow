        "revision"
      ],
      "additionalProperties": false
    },
    "workspace.conversation.post.input": {
      "type": "object",
      "properties": {
        "conversation": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/ConversationSelector"
        },
        "parts": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/MessagePartInputs"
        },
