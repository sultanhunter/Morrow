          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/ReadState"
        }
      },
      "required": [
        "itemIds",
        "state"
      ],
      "additionalProperties": false
    },
    "workspace.inbox.mark.output": {
      "type": "object",
      "properties": {
        "updated": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/Count"
        }
      },
      "required": [
        "updated"
      ],
      "additionalProperties": false
    },
    "governance.access.request.input": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/AccessRequestScope"
        },
        "reason": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/RequestReason"
        },
        "context": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/AccessRequestContext"
        }
      },
      "required": [
        "scope",
        "reason",
        "context"
      ],
      "additionalProperties": false
    },
    "governance.access.request.output": {
      "type": "object",
      "properties": {
        "accessRequestId": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/Id"
        },
        "status": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/AccessRequestStatus"
        }
      },
      "required": [
        "accessRequestId",
        "status"
      ],
      "additionalProperties": false
    },
    "governance.billing.manage.input": {
      "description": "M5 PR-1 (ADR-0022 items 2 and 12): the server-built input of a Morrow-direct purchase action. subscribe names exactly one price key; billing_portal names none.",
      "type": "object",
      "properties": {
        "action": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/BillingManageAction"
        },
        "priceKey": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/NullableStripePriceKey"
        }
      },
      "required": [
        "action",
        "priceKey"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "action": {
                "const": "subscribe"
              }
            },
            "required": [
              "action"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "priceKey": {
                "type": "string"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "priceKey": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "governance.billing.manage.output": {
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/Id"
        }
      },
      "required": [
        "operationId"
      ],
      "additionalProperties": false
    },
    "governance.model_default.revise.input": {
      "description": "M5 PR-1 (ADR-0022 items 3 and 16): the workspace default model selection and member ceiling. model and effort are opaque catalogue keys; expectedRevision is null for the first revision.",
      "type": "object",
      "properties": {
        "model": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/ModelOptionKey"
        },
        "effort": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/ModelOptionKey"
        },
        "maxCreditsPerProduct": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/CreditsPerProductCeiling"
        },
        "expectedRevision": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/NullableRevision"
        }
      },
      "required": [
        "model",
        "effort",
        "maxCreditsPerProduct",
        "expectedRevision"
      ],
      "additionalProperties": false
    },
    "governance.model_default.revise.output": {
      "type": "object",
      "properties": {
        "revision": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/Revision"
        }
      },
      "required": [
        "revision"
      ],
      "additionalProperties": false
    },
    "runtime.execution.use.input": {
      "description": "Build order PR 7 (ADR-0029 item 7): the grant-level request of one computer job under a run. The job itself is RuntimeJob@1, checked by hand in the broker (no command, template, network, environment or limit); its inputs are minimised extracts with fixed column allowlists.",
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/Id"
        },
        "inputs": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/ArtifactList"
        }
      },
      "required": [
        "runId",
        "inputs"
      ],
      "additionalProperties": false
    },
    "runtime.execution.use.output": {
      "description": "Build order PR 7: the job's runtime operation, its checked PNG, CSV and XLSX outputs as untrusted downloads, and the receipt of its worst-case booking.",
      "type": "object",
      "properties": {
        "operationId": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/Id"
        },
        "outputs": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/ArtifactList"
        },
        "costReceipt": {
          "$ref": "urn:morrow:contracts:core:v1#/$defs/EvidenceRef"
        }
      },
      "required": [
        "operationId",
        "outputs",
        "costReceipt"
      ],
      "additionalProperties": false
    }
  }
}
