          "$ref": "urn:morrow:contracts:core:v1#/$defs/ProposalRef"
        },
        "selectedTargetIndexes": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/TargetSelection"
        }
      },
      "required": [
        "proposalRef",
        "selectedTargetIndexes"
      ],
      "additionalProperties": false
    },
    "governance.approval.preview.output": {
      "type": "object",
      "properties": {
        "proposal": {
          "$ref": "urn:morrow:contracts:core:v1.1#/$defs/Proposal"
        }
      },
      "required": [
        "proposal"
      ],
      "additionalProperties": false
    },
    "workspace.conversation.create.input": {
